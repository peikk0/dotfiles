[user]
    email = pierre@guinoiseau.nz
    name = Pierre Guinoiseau
    signingkey = 0x8D1C3224FAB5BA48

[advice]
    detachedHead = false
    statusHints = false

[alias]
    br = branch
    ci = commit
    co = checkout
    cp = cherry-pick
    dc = diff --cached
    df = diff
    lg = log -p
    lgs = log --stat
    lol = log --pretty=ol
    lolg = log --graph --pretty=ol
    lola = lol --all
    ls = ls-files
    st = status

[color]
    ui = auto
[color "branch"]
    current = "#89dceb"
    local = "#74c7ec"
    remote = "#89b4fa"
[color "decorate"]
    HEAD = "#a6e3a1"
    branch = "#74c7ec"
    grafted = "#f9e2af"
    remoteBranch = "#89b4fa"
    stash = "#fab387"
    tag = "#b4befe"
[color "diff"]
    meta = "#9399b2"
    frag = "#fab387"
    old = "#f38ba8"
    new = "#a6e3a1"
    # also the colour of %(decorate) decoration elements
    commit = "#6c7086"
[color "grep"]
    context = "#6c7086"
    filename = "#74c7ec"
    lineNumber = "#89b4fa"
    column = "#89b4fa"
    function = "#cba6f7"
    match = "#313244 #f38ba8"
    separator = "#6c7086"
[color "status"]
    added = "#a6e3a1"
    changed = "#fab387"
    untracked = "#cba6f7"

[commit]
    status = false

[core]
    excludesfile = ~/.config/git/ignore
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[delta]
    dark = true
    keep-plus-minus-markers = false
    navigate = true
    paging = always
    side-by-side = false
    syntax-theme = Catppuccin Mocha
    pager = less -S

    blame-code-style = syntax
    blame-format = "{author:<20} ({commit:>10}) {timestamp:<15} "
    blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"

    commit-decoration-style = "#6c7086" bold box ul

    dark = true

    file-style = "#cdd6f4"
    file-decoration-style = "#6c7086"
    file-added-label = [+]
    file-copied-label = [=]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [>]

    hunk-header-decoration-style = "#6c7086" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "#a6adc8"
    hunk-header-style = file line-number syntax

    line-numbers = true
    line-numbers-left-style = "#6c7086"
    line-numbers-minus-style = italic "#f38ba8"
    line-numbers-plus-style = italic "#a6e3a1"
    line-numbers-right-style = "#6c7086"
    line-numbers-zero-style = italic "#6c7086"
    line-numbers-left-format = " {nm:>3} │"
    line-numbers-right-format = " {np:>3} │"

    map-styles = \
        bold purple => syntax "#5b4e74", \
        bold blue => syntax "#445375", \
        bold cyan => syntax "#446170", \
        bold yellow => syntax "#6b635b"

    merge-conflict-begin-symbol = ~
    merge-conflict-end-symbol = ~
    merge-conflict-ours-diff-header-style = "#fab387" bold
    merge-conflict-ours-diff-header-decoration-style = "#313244" box
    merge-conflict-theirs-diff-header-style = "#f9e2af" bold
    merge-conflict-theirs-diff-header-decoration-style = "#313244" box

    # 35% red 65% base
    minus-emph-style = bold syntax "#694559"
    # 20% red 80% base
    minus-style = syntax "#493447"
    # 35% green 65% base
    plus-emph-style = bold syntax "#4e6356"
    # 20% green 80% base
    plus-style = syntax "#394545"
    zero-style = syntax

    grep-file-style = "#74c7ec"
    grep-header-decoration-style = "#313244" box
    grep-line-number-style = "#89b4fa" italic

    whitespace-error-style = "reverse #cba6f7"

[diff]
    colorMoved = default
    renameLimit = 8192
    submodule = log
    tool = nvim_difftool

[difftool "nvim_difftool"]
    cmd = nvim -c \"packadd nvim.difftool\" -d \"$LOCAL\" \"$REMOTE\"

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process


[filter "media"]
    clean = git-media-clean %f
    smudge = git-media-smudge %f

[github]
    user = peikk0

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only --features=interactive

[log]
    date = iso-local
    decorate = short
    graphColors = "#f38ba8,#fab387,#f9e2af,#a6e3a1,#74c7ec,#b4befe"

[merge]
    conflictstyle = diff3
    tool = diffconflicts

[mergetool]
    keepBackup = false

[mergetool "diffconflicts"]
    cmd = nvim -c DiffConflicts \"${MERGED}\" \"${BASE}\" \"${LOCAL}\" \"${REMOTE}\"
    trustExitCode = true

[pager]
    blame = delta
    diff = delta
    log = delta
    reflog = delta
    show = delta

[pretty]
    ol = "format:%C(#9ca0b0) %h%C(auto)%(decorate:prefix=  ,suffix=,pointer=  ,separator= ,tag= )%C(reset)  %s %C(#74c7ec) %cr %C(#b4befe) %an <%ae>%C(reset)"

[pull]
    rebase = false

[push]
    default = simple

[status]
    short = true

[include]
    path = ~/.config/git/config.local
